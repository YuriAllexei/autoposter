# autoposter — environment config
# Copy to .env and edit. Alternate file location: export AP_ENV_FILE=/path/to/.env
# (real environment variables always WIN over the file — config.load_config).
# Copy to `.env` (gitignored) and adjust. All paths relative to repo root.
# Convention: every var is read by the poster/config loader with AP_ prefix.

# ============================== SAFETY ======================================
# Master dry-run switch. TRUE = open composer, type text, attach photos, but
# NEVER click "Publicar"/publish. Rule of the repo: nothing posts or comments
# until a selector has been proven correct against a recording/dry-run.
AP_DRY_RUN=true
# Headed (false) while developing so you can watch; WSLg shows the window.
AP_HEADLESS=false
# Cap per run over the LIVE-joined groups (rotation picks the never-attempted
# ones first). 2026-09-23 operator call: 15 = whole board in ONE run — one
# browser, no relaunch/re-login between posts (raise above your joined count
# to stop rotating).
AP_MAX_POSTS_PER_RUN=15

# ============================ BROWSER SESSION ================================
# Persistent Firefox profile — holds the FB login cookies. Log in ONCE by hand
# (headed run / probe_group.py); automation reuses it. No password ever lives
# in code, git, or this file.
AP_PROFILE_DIR=.local-capture/profiles/facebook
# Viewport for the browser window (composer layout depends on it).
AP_VIEWPORT_WIDTH=1280
AP_VIEWPORT_HEIGHT=900

# ============================== FACEBOOK IDs =================================
# Numeric FB user IDs (not emails). How to get them (10 seconds, no code):
#   AP_FB_MAIN_USER    = the `c_user` cookie while logged in as your personal
#                        account: facebook.com -> DevTools (F12) -> Application
#                        -> Cookies -> https://www.facebook.com -> `c_user`.
#                        (or: your profile URL = facebook.com/profile.php?id=THIS)
#   AP_FB_POSTING_USER = the `i_user` cookie AFTER switching to the
#                        professional profile via the top-right avatar menu
#                        (same cookie panel). Also visible as `av=` on any
#                        /api/graphql/ request in the Network tab.
# Values below came from the 2026-09-17 recording on the old host — verify
# them against the cookies on this host's first logged-in run.
AP_FB_MAIN_USER=61592579496197
# Professional profile we POST AS — i_user cookie + profile-menu name.
AP_FB_POSTING_USER=61592323007979
AP_FB_POSTING_PROFILE_NAME=Carmazon
# Which identity publishes: "page" = professional profile above, or
# "profile" = the PERSONAL login itself. When 'profile', the account-menu
# ROW TEXT is AP_FB_MAIN_PROFILE_NAME (recording 20260922T210535Z: the
# personal profile is listed as "Carmazon Alex", NOT the legal name) and
# the acting identity is verified via the av= param on /api/graphql.
AP_POST_AS=page
# When AP_POST_AS=profile: the account-menu ROW TEXT of the personal
# profile (e.g. "Carmazon Alex"), NOT its legal name.
AP_FB_MAIN_PROFILE_NAME=

# ============================== GROUPS / FLOWS ===============================
# No groups file anymore: each run fetches the identity's JOINED groups live
# (poster/groups_fetch.py) and rotates never-attempted-first, capped by
# AP_MAX_POSTS_PER_RUN. A group is postable iff its composer trigger renders
# within 5s of the page load, else it is `skipped`. See AGENTS.md rule 4.
# ============================== CONTENT ======================================
# Post text, copied 1:1 into the composer (summary of car inventory).
AP_POST_TEXT_FILE=data/post.txt
# Photos root: one sub-folder per car, e.g. data/car_photos/01_tacoma_2021/*.jpg
# Car sub-folders are posted in SORTED name order (use NN_ prefixes); photos
# inside a car folder in filename order. Image order must match post.txt order.
AP_PHOTOS_DIR=data/car_photos
# Accepted photo extensions, comma-separated, sorted per above.
AP_PHOTO_EXTENSIONS=.jpg,.jpeg,.png,.webp
# Max photos per post (FB composer caps ~20; keep human-ish lower).
AP_MAX_PHOTOS_PER_POST=10

# ============================ RATE LIMITING ==================================
# Random pause for GENERAL actions (first-group open, page nav, publish).
# User rule (2026-09-22): keep it short — 2-4 seconds. The config loader
# HARD-CAPS any configured value at 7s (poster/config.py:MAX_ALLOWED_DELAY),
# which is a safety ceiling, NOT the operating range.
AP_DELAY_MIN_SECONDS=2
AP_DELAY_MAX_SECONDS=4
# GROUP CHANGE (explicit user rule 2026-09-22): after finishing one group,
# wait 10-15s before opening the next. Separate category from the general
# delays above; own safety ceiling 20s (config.py:MAX_ALLOWED_GROUP_SWITCH).
AP_GROUP_SWITCH_MIN_SECONDS=10
AP_GROUP_SWITCH_MAX_SECONDS=15
# Typing humanization: per-char delay range (ms) when typing the post text.
AP_TYPE_DELAY_MIN_MS=30
AP_TYPE_DELAY_MAX_MS=90

# ============================== OUTPUT / DEBUG ===============================
AP_LOG_DIR=.local-capture/logs
AP_SCREENSHOT_DIR=.local-capture/shots
# ========================= MONITORING / DISCORD =============================
# After every run the bot sends ONE summary embed to this webhook (webhooks
# need no bot token/app: Discord channel -> Integrations -> Webhooks ->
# New Webhook -> Copy URL). Empty = no notification; a send failure NEVER
# fails the run. See poster/notify.py; test with:
#   poetry run python -m poster.notify --test
AP_DISCORD_WEBHOOK_URL=
# JSONL ledger, one line per group attempt (run_id/group/status). Powers the
# all-time "successfully published" counters per group id. Gitignored location.
AP_LEDGER_FILE=.local-capture/results/ledger.jsonl

# ================= MARKETPLACE CROSSPOST (poster/crosspost.py) ===============
# Mass-publish active listings into joined groups ("Publicar en más lugares").
# FB hard-caps one submission at 20 groups (reads marketplace_crosspost_limit
# live). ALL batches run in one go, ~2 min apart (user spec 2026-09-23;
# hard-capped at 300s by config like every other wait):
AP_CROSSPOST_GAP_MIN_SECONDS=110
AP_CROSSPOST_GAP_MAX_SECONDS=130
# listings per run (0 = every active listing):
AP_CROSSPOST_MAX_LISTINGS=0
# sleeps BETWEEN crosspost actions (open menu, menu item, Publicar, Cancelar)
# are their own category — user spec uniform 1-3s (group checkbox ticks inside
# the dialog use a fixed 0.2-1s micro-pause, see poster/flows.py):
AP_CROSSPOST_ACTION_MIN_SECONDS=1
AP_CROSSPOST_ACTION_MAX_SECONDS=3

# ==================== INDIVIDUAL SHARES (poster/share.py) ====================
# Share each active listing into EACH joined group one by one: listing card ->
# Compartir -> hub 'Grupo' -> group picker (name search) -> composer with the
# listing link attached -> paste the listing description 1:1 -> Publicar.
# The wait BETWEEN consecutive group-shares — group to group AND listing to
# listing — is its OWN category (user spec 2026-09-25): uniform 10-15s, the
# group-change pacing (first pass was 2-3s). It never sleeps after the LAST
# share of the run. Own safety ceiling 20s
# (config.py:MAX_ALLOWED_SHARE_GAP); the general 7s cap does NOT apply.
AP_SHARE_GAP_MIN_SECONDS=10
AP_SHARE_GAP_MAX_SECONDS=15
